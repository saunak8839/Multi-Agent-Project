DATABASE_URL=postgresql://support_desk:support_desk@localhost:5432/support_desk
POSTGRES_DB=support_desk
POSTGRES_USER=support_desk
POSTGRES_PASSWORD=support_desk
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4o-mini
LANGGRAPH_STRICT_MSGPACK=true
# Optional price rates used for estimated LLM cost in traces (USD per 1M tokens).
# Set these to match the model/provider rates for the account in use.
LLM_INPUT_COST_PER_1M=
LLM_OUTPUT_COST_PER_1M=

# Chat adapters: openai, openai_compatible, or google_genai. Blank model/key uses OpenAI defaults above.
CHAT_PROVIDER=openai
CHAT_MODEL=
CHAT_API_KEY=
CHAT_BASE_URL=
# Embeddings are configured independently of chat.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
# Optional API output-size request; use only with models that support it.
EMBEDDING_OUTPUT_DIMENSIONS=
